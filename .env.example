# ========================================================
# RailSight AI / TrackX - Environment Configuration
# ========================================================

# RailRadar API Key (All requests securely routed via Backend only)
# Get your API key from https://railradar.in/docs
RAILRADAR_API_KEY=

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Dynamic Background Simulation / Fleet Refresh Interval (seconds)
FLEET_SIMULATION_INTERVAL_SEC=15
NETWORK_CONGESTION_REFRESH_SEC=30
